{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bobaks-ranking-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 0 * * *"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a4e7160cac2648ebb6b35937f45d9457"
    }
  ],
  "previews": {}
}
