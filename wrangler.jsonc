{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bobaks-ranking-api",
  "main": "src/frontend-worker.ts",
  "compatibility_date": "2026-09-23",
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/game/*",
      "/rankings/*",
      "/sitemap.xml",
      "/robots.txt",
      "/community",
      "/analytics"
    ]
  },
  "vars": {
    "API_ORIGIN": "https://bobaks-ranking-api-service.ryan-oledan0.workers.dev"
  },
  "services": [
    {
      "binding": "API",
      "service": "bobaks-ranking-api-service"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "bobaks_product_web"
    }
  ],
  "previews": {\n    "vars": {\n      "DEMO_MODE": "1"\n    }\n  },
  "run_worker_first": [
    "/game/*",
    "/rankings/*",
    "/sitemap.xml",
    "/robots.txt",
    "/community",
    "/analytics",
    "/admin/*"
  ]
}
