{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bobaks-ranking-api-service",
  "main": "src/api-worker.ts",
  "compatibility_date": "2026-09-23",
  "vars": {
    "SUPABASE_URL": "https://zhrfozouzvxhpkylmpwh.supabase.co",
    "BOBAKS_ALLOWED_ORIGINS": "https://web.bobaksranking.workers.dev"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "bobaks_product_api"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "2026100701",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "API_HEAVY_RATE_LIMITER",
      "namespace_id": "2026100702",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
